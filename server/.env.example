# Copy this file to .env and fill in the values.

PORT=5000
NODE_ENV=development

# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cinebook

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend URL (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# TMDB -> Settings -> API -> "API Read Access Token" (the long one, not the API key)
TMDB_READ_TOKEN=

# Razorpay -> Test Mode -> Account & Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you add a webhook in the Razorpay dashboard (needs a public URL, so after deploying)
RAZORPAY_WEBHOOK_SECRET=

# How long a user can hold seats before paying
SEAT_LOCK_MINUTES=5

# Admin account created by `npm run seed` (local dev only - change for production)
ADMIN_EMAIL=admin@cinebook.dev
ADMIN_PASSWORD=Admin@12345
